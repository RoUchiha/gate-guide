# Live flight data (FlightAware AeroAPI). Without a key the app either uses
# demo flights (default) or refuses flight lookups (GATE_GUIDE_FLIGHT_MODE=production).
FLIGHTAWARE_AEROAPI_KEY=
GATE_GUIDE_FLIGHT_MODE=

# Airport maps. Bundled OSM maps in public/maps/ serve as the production map
# source automatically. GATE_GUIDE_MAP_MODE=production refuses demo-map
# fallback for airports without a real bundle.
GATE_GUIDE_MAP_MODE=

# Optional remote map sources (take precedence over bundled maps).
AIRPORT_MAP_CATALOG_URL=
AIRPORT_MAP_BUNDLE_BASE_URL=
AIRPORT_MAP_BUNDLE_TOKEN=
